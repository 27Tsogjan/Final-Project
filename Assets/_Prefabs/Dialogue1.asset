  m_Script: {fileID: 11500000, guid: f0063217e025e4651addfae7908b9c1a, type: 3}
  m_Name: Dialogue1
  m_EditorClassIdentifier: 
  title: Old Scout
  lines: "Halt, traveler! Turn back while you still draw breath\u2014darkness has
    fallen over the kingdom. Wait... I know that face. You rode beside the King in
    the old wars, didn't you? His long-lost friend, returned at last. I grieve to
    tell you this, old friend: a ruthless demon breached the throne room last night
    and struck the King down. The crown lies shattered in the dust. Press onward
    down this forest road if you truly mean to avenge him."
  requiredProgress: 0
