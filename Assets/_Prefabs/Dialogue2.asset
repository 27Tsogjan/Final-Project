  m_Script: {fileID: 11500000, guid: f0063217e025e4651addfae7908b9c1a, type: 3}
  m_Name: Dialogue2
  m_EditorClassIdentifier: 
  title: Old Scout
  lines: "You made it past the outer woods... good. The air grows heavier the closer
    we get to the capital. That demon didn't just slay our King\u2014it warped the
    castle into a fortress of shadow and corrupted the royal guard. The King spoke
    of you before the end, saying only someone who knew his heart could ever stand
    against such evil. Keep moving east. The castle gates lie just beyond the next
    ridge, and its corrupted sentries are already waiting."
  requiredProgress: 0
